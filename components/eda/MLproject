name: eda
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Input artifact for EDA
        type: string

      output_artifact:
        description: Output artifact for EDA
        type: string

      output_type:
        description: Type of the output artifact
        type: string

      output_description:
        description: Description of the output artifact
        type: string

    command: "python eda.py --input_artifact {input_artifact} --output_artifact {output_artifact} --output_type {output_type} --output_description {output_description}"

